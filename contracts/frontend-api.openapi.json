  "info": {
    "description": "A same-origin browser contract. Trusted-adult credentials stay in the Next.js server layer; the teen access token is held in an HttpOnly cookie.",
    "title": "Hobbi demo frontend API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/approve": {
      "post": {
        "operationId": "approvePlan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoApproveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingStepResponse"
                }
              }
            },
            "description": "Successful demo operation"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorView"
                }
              }
            },
            "description": "Safe frontend error"
          }
        }
      }
    },
    "/api/attendance": {
      "post": {
        "operationId": "recordAttendance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoAttendanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceStepResponse"
                }
              }
            },
            "description": "Successful demo operation"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorView"
                }
              }
            },
            "description": "Safe frontend error"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"
                }
              }
            },
            "description": "Successful demo operation"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorView"
                }
              }
            },
            "description": "Safe frontend error"
          }
        }
      }
    },
    "/api/next-plan": {
      "post": {
        "operationId": "createNextPlan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoNextPlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanStepResponse"
                }
              }
            },
            "description": "Successful demo operation"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorView"
                }
              }
            },
            "description": "Safe frontend error"
          }
