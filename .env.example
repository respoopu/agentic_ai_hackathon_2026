# Hobbi creates SQLite files here. The default is .hobbi/ in the repository.
HOBBI_RUNTIME_DIR=.hobbi

# Required for trusted-adult setup/approval and operator-only freshness scans.
# Use independent high-entropy secrets and send them as Bearer tokens.
HOBBI_GUARDIAN_API_TOKEN=replace-with-a-random-guardian-secret
HOBBI_COMPLIANCE_API_TOKEN=replace-with-a-random-compliance-secret

# Read only by the Next.js server layer. The browser never receives either token.
HOBBI_API_URL=http://127.0.0.1:8080

# Bedrock is lazy: offline tests and simulation do not need AWS credentials.
AWS_REGION=ap-southeast-1
